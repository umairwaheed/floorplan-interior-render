# Copy to .env and fill in. The pipeline runs end-to-end without any keys by
# using IMAGE_BACKEND=mock, which passes the geometry maps through instead of
# calling an image model.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# mock | gemini
IMAGE_BACKEND=mock

# Set to false to skip the consistency judge (faster, cheaper, unverified).
ENABLE_JUDGE=true
CONSISTENCY_THRESHOLD=0.75
MAX_RENDER_ATTEMPTS=3
